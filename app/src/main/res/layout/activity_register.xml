<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/freela_dark_background"
                android:padding="20dp">

    <!-- Header Area -->
    <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

        <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:fontFamily="sans-serif-medium"
                android:text=" FreelaDuo"
                android:textColor="@color/freela_white"
                android:textSize="22sp" />
    </LinearLayout>

    <!-- Título Principal -->
    <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/header"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Como deseja\nse cadastrar?"
            android:textColor="@color/freela_white"
            android:textSize="28sp" />

    <!-- Container dos Cards Empilhados na Vertical e Centralizados -->
    <LinearLayout
            android:id="@+id/cardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtTitle"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

        <!-- Card Freelancer -->
        <LinearLayout
                android:id="@+id/cardFreelancer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_freelancer"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

            <androidx.cardview.widget.CardView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/freela_tela" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Freelancer com a conta de freelancer para se cadastrar."
                        android:textColor="@color/freela_white_subtle"
                        android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                    android:id="@+id/btnArrowFreelancer"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/ic_circle_arrow"
                    android:backgroundTint="@color/freela_purple_primary"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="@color/freela_white" />
        </LinearLayout>

        <!-- Card Empresa -->
        <LinearLayout
                android:id="@+id/cardEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_company"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

            <androidx.cardview.widget.CardView
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/empresa_tela" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Company com uma conta de empresa com a empresa."
                        android:textColor="@color/freela_white_subtle"
                        android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                    android:id="@+id/btnArrowCompany"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/ic_circle_arrow"
                    android:backgroundTint="@color/freela_dark_blue_light"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_media_play"
                    app:tint="@color/freela_white" />
        </LinearLayout>

    </LinearLayout>

    <!-- Rodapé Fixado na Parte Inferior -->
    <LinearLayout
            android:id="@+id/footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Já tem uma conta? "
                android:textColor="@color/freela_white_subtle" />

        <TextView
                android:id="@+id/txtBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:text="Faça Login"
                android:textColor="@color/freela_purple_primary" />
    </LinearLayout>

    <!-- Card Informativo de Segurança -->
    <LinearLayout
            android:id="@+id/cardInfoSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/footer"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_info_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

        <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/ic_circle_arrow"
                android:backgroundTint="#1A153B"
                android:padding="12dp"
                android:src="@drawable/ic_verified_shield" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="3dp"
                android:text="Segurança, praticidade e conexões que impulsionam seus projetos."
                android:textColor="@color/freela_white"
                android:textSize="14sp" />
    </LinearLayout>

</RelativeLayout>