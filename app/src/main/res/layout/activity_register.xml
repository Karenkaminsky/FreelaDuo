<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
                xmlns:tools="http://schemas.android.com/tools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#05050A"
                android:padding="16dp"
                tools:ignore="HardcodedText,UnusedAttribute">

    <!-- ================================================================
         CABEÇALHO: LOGO + NOME DO APLICATIVO
         ================================================================ -->
    <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

        <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/logo"
                tools:ignore="ImageContrastCheck" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-bold"
                android:text="FreelaDuo"
                android:textColor="#FFFFFF"
                android:textSize="24sp" />

    </LinearLayout>

    <!-- =========== Título Principal ===========  -->
    <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/header"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="30dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:text="Como deseja se cadastrar?"
            android:textColor="#FFFFFF"
            android:textSize="24sp" />

    <!-- Subtítulo explicando a escolha do perfil -->
    <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtTitle"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="Escolha o perfil que melhor combina\ncom você e comece agora."
            android:textColor="#A1A5B7"
            android:textSize="14sp" />

    <!-- ================================================================
         RODAPÉ
         ================================================================ -->
    <LinearLayout
            android:id="@+id/footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Já tem uma conta? "
                android:textColor="#9AA0A6"
                android:textSize="13sp" />

        <TextView
                android:id="@+id/txtBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center_vertical"
                android:text="Faça Login"
                android:textColor="#9D65FF"
                android:textSize="13sp"
                tools:ignore="DuplicateSpeakableTextCheck" />

    </LinearLayout>

    <!-- ================================================================
         CARD INFORMATIVO DE SEGURANÇA
         ================================================================ -->
    <LinearLayout
            android:id="@+id/cardInfoSecurity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/footer"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_info_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

        <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_verified_shield"
                tools:ignore="ImageContrastCheck" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="Segurança, praticidade e conexões que impulsionam seus projetos."
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

    </LinearLayout>

    <!-- ================================================================
         CONTAINER DOS CARDS
         ================================================================ -->
    <LinearLayout
            android:id="@+id/cardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/cardInfoSecurity"
            android:layout_below="@id/txtSubtitle"
            android:gravity="center_vertical"
            android:orientation="vertical">

        <!-- ========= CARD FREELANCER ========= -->
        <RelativeLayout
                android:id="@+id/cardFreelancer"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_freelancer"
                android:padding="16dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/imgFreelancer3D"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Freelancer"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="Conta para quem trabalha por conta própria e busca novas oportunidades."
                        android:textColor="#C5CAE9"
                        android:textSize="11sp" />

                <!-- Botão sem seta e com efeito de clique aprimorado -->
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCadastrarFreelancer"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="#7C4DFF"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="24dp"
                        android:text="Cadastrar"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

            </LinearLayout>

            <ImageView
                    android:id="@+id/imgFreelancer3D"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/freela_tela"
                    tools:ignore="ImageContrastCheck" />

        </RelativeLayout>

        <!-- ================= CARD EMPRESA ================= -->
        <RelativeLayout
                android:id="@+id/cardEmpresa"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@drawable/bg_card_company"
                android:padding="16dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/imgEmpresa3D"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Empresa"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif"
                        android:text="Conta para empresas que buscam profissionais qualificados para seus projetos."
                        android:textColor="#C5CAE9"
                        android:textSize="11sp" />

                <!-- Botão sem seta e com efeito de clique aprimorado -->
                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCadastrarCompany"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:backgroundTint="#5D3EBC"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="24dp"
                        android:text="Cadastrar"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />

            </LinearLayout>

            <ImageView
                    android:id="@+id/imgEmpresa3D"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/empresa_cadastro"
                    tools:ignore="ImageContrastCheck" />

        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>