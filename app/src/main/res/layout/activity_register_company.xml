<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#090A10"
            android:fillViewport="true"
            tools:ignore="HardcodedText">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

        <!-- ============================================================ -->
        <!-- CABEÇALHO FUTURISTA                                          -->
        <!-- ============================================================ -->
        <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/prociono_regular"
                        android:text="FreelaDuo"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />
            </LinearLayout>

            <!-- Badge Enterprise com Cantos Arredondados estilo Pílula -->
            <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:cardBackgroundColor="#1A102F"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#3B2063"
                    app:strokeWidth="1dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.05"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="✦ ENTERPRISE"
                        android:textColor="#C084FC"
                        android:textSize="10sp" />
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <!-- TÍTULO COM DESTAQUE -->
        <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Conecte sua Empresa"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

        <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif"
                android:text="Acesse o ecossistema avançado de talentos tech e criativos."
                android:textColor="#6B7280"
                android:textSize="14sp" />

        <!-- ============================================================ -->
        <!-- CARD 1: DADOS DA EMPRESA (GLASS EFFECT)                     -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="#0F111A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1F2438"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#C084FC" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.08"
                            android:text="ORGANIZAÇÃO"
                            android:textColor="#E9D5FF"
                            android:textSize="12sp" />
                </LinearLayout>

                <!-- Nome Fantasia -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Nome Fantasia"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCompanyName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Razão Social -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Razão Social"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCorporateName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CNPJ e Segmento em Linha (Grid Responsivo de 2 colunas) -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="CNPJ"
                            app:boxBackgroundColor="#161926"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#2A304D"
                            app:hintTextColor="#A78BFA">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtCNPJ"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="18"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="Segmento"
                            app:boxBackgroundColor="#161926"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#2A304D"
                            app:hintTextColor="#A78BFA">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtSegment"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Localização & Website -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:hint="Localização (Cidade, UF)"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPostalAddress"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Website ou LinkedIn"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtWebsite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- CARD 2: CONTATO E PREFERÊNCIAS                               -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="#0F111A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1F2438"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#3B82F6" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.08"
                            android:text="CONTATO E PONTOS DE CONTROLE"
                            android:textColor="#93C5FD"
                            android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Responsável Direto"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtResponsibleName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="E-mail Corporativo"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCompanyEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo Telefone / WhatsApp -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Telefone / WhatsApp"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCompanyPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Seleção de Contato e pontos de controles -->
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:text="Modelo de Demanda"
                        android:textColor="#9CA3AF"
                        android:textSize="12sp" />

                <RadioGroup
                        android:id="@+id/rgContractType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="4dp">

                    <RadioButton
                            android:id="@+id/rbProject"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Projeto"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                    <RadioButton
                            android:id="@+id/rbHourly"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hora"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                    <RadioButton
                            android:id="@+id/rbBoth"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ambos"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ============================================================ -->
        <!-- CARD 3: SEGURANÇA                                            -->
        <!-- ============================================================ -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#0F111A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1F2438"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Senha de Acesso"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#6B7280"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCompanyPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Confirmar Senha"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#6B7280"
                        app:hintTextColor="#A78BFA">

                    <!-- Validações visuais da senha -->
                    <TextView
                            android:id="@+id/txtRuleLength"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Mínimo de 8 caracteres"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                    <TextView
                            android:id="@+id/txtRuleUppercase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Pelo menos 1 letra maiúscula"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                    <TextView
                            android:id="@+id/txtRuleNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Pelo menos 1 número"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />

                    <TextView
                            android:id="@+id/txtRuleSpecialChar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="• Pelo menos 1 caractere especial (!@#$%...)"
                            android:textColor="#6B7280"
                            android:textSize="12sp" />


                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Termos de Aceite -->
        <CheckBox
                android:id="@+id/cbTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="Concordo com os Termos Corporativos e Diretrizes do Ecossistema."
                android:textColor="#6B7280"
                android:textSize="12sp" />

        <!-- Botão conta corporativa -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegisterCompany"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:backgroundTint="#7C3AED"
                android:fontFamily="sans-serif-bold"
                android:text="Inicializar Conta Corporativa ➔"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:cornerRadius="12dp"
                app:elevation="8dp" />

    </LinearLayout>
</ScrollView>