<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#090B10"
            android:fillViewport="true">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <!-- Header -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Cadastro Freelancer"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Crie seu perfil profissional e encontre projetos"
                android:textColor="#9CA3AF"
                android:textSize="14sp" />

        <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_gradient_line" />

        <!-- CARD 1: DADOS PESSOAIS -->
        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#0F121D"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="▌ DADOS PESSOAIS"
                        android:textColor="#C084FC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <!-- Nome Completo -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Nome Completo"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtFreelancerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- CPF -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="CPF"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtFreelancerCPF"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- CARD 2: PERFIL PROFISSIONAL & CONTATO -->
        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#0F121D"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="▌ PERFIL PROFISSIONAL E ACESSO"
                        android:textColor="#C084FC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <!-- Área de Atuação / Título -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Área de Atuação (ex: Dev Android, Designer)"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtFreelancerRole"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- E-mail -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="E-mail"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtFreelancerEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Senha -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Senha de Acesso"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtFreelancerPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Modalidade de Trabalho (RadioGroup com a bolinha) -->
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:text="Disponibilidade de Atendimento"
                        android:textColor="#9CA3AF"
                        android:textSize="12sp" />

                <RadioGroup
                        android:id="@+id/rgWorkAvailability"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <RadioButton
                            android:id="@+id/rbFreelaProject"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Projeto"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                    <RadioButton
                            android:id="@+id/rbFreelaHourly"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hora"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                    <RadioButton
                            android:id="@+id/rbFreelaBoth"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Ambos"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                </RadioGroup>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Botão Cadastrar -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegisterFreelancer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_button_gradient"
                android:fontFamily="sans-serif-bold"
                android:text="Criar Perfil Freelancer ➔"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:cornerRadius="12dp"
                app:elevation="8dp" />

    </LinearLayout>
</ScrollView>