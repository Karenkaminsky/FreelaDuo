<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#090A10"
            android:fillViewport="true"
            tools:ignore="HardcodedText">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="36dp">

        <!-- CABEÇALHO -->
        <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/prociono_regular"
                        android:text="FreelaDuo"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />
            </LinearLayout>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_badge_talent"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="✦ TALENT PRO"
                    android:textColor="#C084FC"
                    android:textSize="10sp"
                    android:textStyle="bold" />
        </RelativeLayout>

        <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Crie seu Perfil"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

        <TextView
                android:id="@+id/txtSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif"
                android:text="Conecte-se com as melhores empresas e projetos do mercado tech."
                android:textColor="#6B7280"
                android:textSize="14sp" />

        <!-- DADOS PESSOAIS E ENDEREÇO -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="#0F111A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1F2438"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#C084FC" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.08"
                            android:text="INFORMAÇÕES PESSOAIS"
                            android:textColor="#E9D5FF"
                            android:textSize="12sp" />
                </LinearLayout>

                <!-- Nome Completo -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Nome Completo"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtFreelancerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Data de Nascimento e CPF -->
                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="Data de Nasc."
                            app:boxBackgroundColor="#161926"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#2A304D"
                            app:hintTextColor="#A78BFA">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtBirthDate"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:focusable="false"
                                android:inputType="none"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="CPF"
                            app:boxBackgroundColor="#161926"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#2A304D"
                            app:hintTextColor="#A78BFA">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtCPF"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="14"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- CEP, Cidade e Estado -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="CEP"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtZipCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="9"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="2"
                            android:hint="Cidade"
                            app:boxBackgroundColor="#161926"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#2A304D"
                            app:hintTextColor="#A78BFA">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtCity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:hint="UF"
                            app:boxBackgroundColor="#161926"
                            app:boxCornerRadiusBottomEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxStrokeColor="#2A304D"
                            app:hintTextColor="#A78BFA">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edtState"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters"
                                android:maxLength="2"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PERFIL PROFISSIONAL -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="#0F111A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1F2438"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#A78BFA" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.08"
                            android:text="PERFIL PROFISSIONAL"
                            android:textColor="#E9D5FF"
                            android:textSize="12sp" />
                </LinearLayout>

                <!-- Cargo / Especialidade -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Área / Especialidade (ex: UI Designer)"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtRole"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Habilidades (Skills) -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Habilidades (ex: Figma, Kotlin, React)"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtSkills"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sobre Você -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Sobre mim / Biografia"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtAboutMe"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:minLines="3"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Valor Hora -->
                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Valor por Hora (R$)"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtHourlyRate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLength="6"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Modalidade de Trabalho -->
                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="6dp"
                        android:text="Modalidade de Trabalho"
                        android:textColor="#9CA3AF"
                        android:textSize="12sp" />

                <RadioGroup
                        android:id="@+id/rgWorkModality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <RadioButton
                            android:id="@+id/rbRemote"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Remoto"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                    <RadioButton
                            android:id="@+id/rbHybrid"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Híbrido"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                    <RadioButton
                            android:id="@+id/rbOnsite"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Presencial"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CONTATO E REDES -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="#0F111A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1F2438"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <View
                            android:layout_width="4dp"
                            android:layout_height="16dp"
                            android:background="#3B82F6" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.08"
                            android:text="CONTATO E REDES"
                            android:textColor="#93C5FD"
                            android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="E-mail"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="WhatsApp"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtWhatsapp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Telefone (Opcional)"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPhoneOptional"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="LinkedIn / Portfólio (Opcional)"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtLinkedinOptional"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CREDENCIAIS E VALIDAÇÃO DE SENHA -->
        <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#0F111A"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#1F2438"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Senha de Acesso"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#6B7280"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Confirmar Senha"
                        app:boxBackgroundColor="#161926"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="#2A304D"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#6B7280"
                        app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Validações visuais da senha -->
                <TextView
                        android:id="@+id/txtRuleLength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Mínimo de 8 caracteres"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/txtRuleUppercase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Pelo menos 1 letra maiúscula"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/txtRuleNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Pelo menos 1 número"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/txtRuleSpecialChar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Pelo menos 1 caractere especial (!@#$%...)"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BOTÃO DE CADASTRO -->
        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegisterFreelancer"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_button_gradient_purple"
                android:fontFamily="sans-serif-bold"
                android:text="Criar Conta de Freelancer"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:cornerRadius="12dp"
                app:elevation="8dp" />

    </LinearLayout>
</ScrollView>