<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="20dp">

    <!-- Cabeçalho -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vagas Freelance"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="20dp"
        android:text="Oportunidades para profissionais independentes"
        android:textColor="#A7B0C0"
        android:textSize="14sp" />

    <!-- Pesquisa -->
    <EditText
        android:id="@+id/edtPesquisarVaga"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_pesquisa_vagas"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:hint="Buscar cargo, tecnologia ou empresa"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#A7B0C0"
        android:textSize="14sp" />

    <!-- Filtros dinâmicos -->
    <HorizontalScrollView
        android:id="@+id/scrollFiltrosVagas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerFiltrosVagas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="4dp" />

    </HorizontalScrollView>

    <!-- Lista de oportunidades -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/listaVagas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Primeiro cartão -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_vaga">

                <!-- Empresa e cargo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgLogoTotvs"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_logo_vaga"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_totvs"
                        android:contentDescription="Logo da TOTVS" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Desenvolvedor Full Stack"
                            android:textColor="#FFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="TOTVS"
                            android:textColor="#C4B5FD"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Oportunidade freelance"
                            android:textColor="#A7B0C0"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/btn_star_big_off"
                        android:contentDescription="Salvar vaga"
                        app:tint="#A7B0C0" />

                </LinearLayout>

                <!-- Modalidade e nível -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_etiqueta_vaga"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="Pleno"
                        android:textColor="#DDD6FE"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_etiqueta_vaga"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="Remoto"
                        android:textColor="#DDD6FE"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_etiqueta_vaga"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="7dp"
                        android:text="Temporário"
                        android:textColor="#DDD6FE"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Descrição -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Desenvolver funcionalidades para uma plataforma web, trabalhar com APIs e colaborar com a equipe de produto."
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

                <!-- Período -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="▦   10/11/2026 a 16/11/2026"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:text="Período da oportunidade"
                    android:textColor="#A7B0C0"
                    android:textSize="12sp" />

                <!-- Dias e horário -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="◷   Segunda a sexta"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:text="4 horas por dia"
                    android:textColor="#A7B0C0"
                    android:textSize="12sp" />

                <!-- Remuneração -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="R$ 80,00/hora"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Valor informado pela empresa"
                    android:textColor="#A7B0C0"
                    android:textSize="12sp" />

                <!-- Detalhes -->
                <Button
                    android:id="@+id/btnDetalhesVaga"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#6A5ACD"
                    android:text="Ver detalhes da vaga"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
