<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/freela_card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/freela_card_company_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CABEÇALHO DA EMPRESA + AVALIAÇÃO -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgCompanyLogo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/empresa" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/imgCompanyLogo"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCompanyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nexora Tech"
                    android:textColor="@color/freela_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompanyRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 5.0 (124 avaliações)"
                    android:textColor="@color/freela_pink_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_talent"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Freelance Gig"
                android:textColor="@color/freela_purple_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- TÍTULO DA VAGA E DESCRIÇÃO -->
        <TextView
            android:id="@+id/tvJobTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="UI/UX Designer"
            android:textColor="@color/freela_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvJobDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Procuramos designer freelancer para criar interfaces do novo aplicativo."
            android:textColor="@color/freela_white_subtle"
            android:textSize="13sp" />

        <!-- DETALHES (DATA, LOCAL, VALOR/HORA) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvJobDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📅 25 de Set"
                android:textColor="@color/freela_white_subtle"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvJobLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Remoto"
                android:textColor="@color/freela_white_subtle"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvJobRate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💰 R$ 50/h"
                android:textColor="@color/freela_pink_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- BOTÃO APLICAR -->
        <Button
            android:id="@+id/btnApply"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/freela_purple_primary"
            android:text="Candidatar-se"
            android:textAllCaps="false"
            android:textColor="@color/freela_white"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>