<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/freela_card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/freela_card_freelancer_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- CABEÇALHO DO FREELANCER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgFreelancerPhoto"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/freela_tela" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/imgFreelancerPhoto"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvFreelancerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lucas Ferreira"
                    android:textColor="@color/freela_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvFreelancerRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ 4.9 (87 avaliações)"
                    android:textColor="@color/freela_pink_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Disponível"
                android:textColor="@color/freela_pink_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- SOBRE / HABILIDADES -->
        <TextView
            android:id="@+id/tvFreelancerRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Desenvolvedor Back-end | Java • PHP • MySQL"
            android:textColor="@color/freela_white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFreelancerBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Estudante de Informática para Internet. Em busca de novos desafios em tecnologia."
            android:textColor="@color/freela_white_subtle"
            android:textSize="13sp" />

        <!-- BOTÃO DE PERFIL/CONTATO -->
        <Button
            android:id="@+id/btnContact"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/freela_dark_blue_light"
            android:text="Ver Perfil / Contratar"
            android:textAllCaps="false"
            android:textColor="@color/freela_white"
            android:textStyle="bold" />

    </LinearLayout>
</androidx.cardview.widget.CardView>