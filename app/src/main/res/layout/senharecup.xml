<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollSenhaRecup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/modalSenhaRecup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- ================= TELA 1: FORMULÁRIO ================= -->
        <LinearLayout
            android:id="@+id/layoutFormularioRecup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Botão fechar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="end|center_vertical">
                <TextView
                    android:id="@+id/btnFecharRecup"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="×"
                    android:textSize="32sp"
                    android:textColor="#8995B0"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <TextView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="✉"
                android:textSize="54sp"
                android:textColor="#9B5CFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Recuperar senha"
                android:textColor="#F5F6FF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Informe seu e-mail para receber o link de redefinição da senha."
                android:textColor="#9AA8C1"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="E-mail"
                android:textColor="#E8EBF5"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edtEmailRecup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:hint="seu@email.com"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:inputType="textEmailAddress"
                android:textColor="#F5F6FF"
                android:textColorHint="#68748C"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnEnviarRecup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:background="@android:color/transparent"
                android:text="Enviar link de recuperação"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnVoltarLogin"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Voltar para login"
                android:textColor="#9380FF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ================= TELA 2: SUCESSO (CÓDIGO ENVIADO) ================= -->
        <LinearLayout
            android:id="@+id/layoutSucessoRecup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="end|center_vertical">
                <TextView
                    android:id="@+id/btnFecharSucessoRecup"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="×"
                    android:textSize="32sp"
                    android:textColor="#8995B0"
                    android:clickable="true"
                    android:background="?attr/selectableItemBackgroundBorderless" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/circuloSucessoRecup"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_circulo_sucesso"
                android:gravity="center">
                <TextView
                    android:id="@+id/txtCheckSucesso"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#FFFFFF"
                    android:textSize="62sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="Código enviado!"
                android:textColor="#F5F6FF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Um código de confirmação foi encaminhado para seu e-mail:"
                android:textColor="#9AA8C1"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtEmailConfirmacaoRecup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:padding="16dp"
                android:gravity="center"
                android:background="@drawable/bg_email_confirmacao"
                android:text="seu@email.com"
                android:textColor="#F5F6FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEntendiRecup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@android:color/transparent"
                android:text="Já tenho o código"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ================= TELA 3: VALIDAR CÓDIGO ================= -->
        <LinearLayout
            android:id="@+id/layoutValidarCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Digite o código"
                android:textColor="#F5F6FF"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="Insira o código de 6 dígitos enviado para seu e-mail."
                android:textColor="#9AA8C1"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/edtCodigo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_email_confirmacao"
                android:hint="000000"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="6"
                android:textColor="#F5F6FF"
                android:textColorHint="#68748C"
                android:textSize="24sp" />

            <Button
                android:id="@+id/btnValidarCodigo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:background="@android:color/transparent"
                android:text="Validar código"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>