<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#0D192B"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/logo"
        android:scaleType="fitCenter"
        android:contentDescription="Logo FreelaDuo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:text="Freela"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtLogoDuo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Duo"
        android:textColor="#6A5ACD"
        android:textSize="21sp"
        android:textStyle="bold" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1A102F"
        app:cardCornerRadius="50dp"
        app:cardElevation="0dp"
        app:strokeColor="#3B2063"
        app:strokeWidth="1dp">

        <TextView
            android:id="@+id/txtIdentificacaoTela"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ FEED"
            android:textColor="#C084FC"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp" />

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>